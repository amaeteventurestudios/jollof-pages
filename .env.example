# ============================================================
# JOLLOF PAGES — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Supabase ----
# Get these from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Cloudflare R2 ----
# All R2 values are server-only — never expose to client
# Get from Cloudflare Dashboard → R2 → Manage API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Bucket names — create these in Cloudflare R2 before launching
CLOUDFLARE_R2_BUCKET_ASSETS=jollof-pages-assets
CLOUDFLARE_R2_BUCKET_EXPORTS=jollof-pages-exports

# Public base URL — only set if bucket has public access enabled
# e.g. https://assets.yourdomain.com or https://pub-xxx.r2.dev
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Signed URL TTL in seconds (default: 3600 = 1 hour)
CLOUDFLARE_R2_SIGNED_URL_TTL_SECONDS=3600

# ---- Admin Auth ----
# HTTP Basic Auth credentials for /admin routes.
# Set both to protect the admin panel in production.
ADMIN_USERNAME=admin@yourdomain.com
ADMIN_PASSWORD=your-strong-admin-password-here

# ---- Admin Dev Convenience ----
# Set to any workspace UUID to load live data in admin panels.
# Not required in production — admin panels are workspace-aware via session.
DEMO_WORKSPACE_ID=

# ---- App Config ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Story OS (optional) ----
# Path to Story OS JSON files (relative to project root)
# STORY_OS_PATH=./story-os

# ---- Future: AI Integration (deferred) ----
# AI provider integration is deferred.
# Claude Code and Codex are used as external development/editing assistants.
# No in-app AI provider keys required yet.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
