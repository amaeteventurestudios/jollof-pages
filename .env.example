# --- production (docker compose) ---
SITE_DOMAIN=jollofpages.com
PB_DOMAIN=pb.jollofpages.com

# --- AI cover art (see docs/AI_COVERS.md); empty = test mode ---
# The web server signs in to PocketBase as a superuser to keep the credit ledger.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# fal.ai key (fal.ai/dashboard/keys). Default model: fal-ai/nano-banana-2
FAL_KEY=
# Stripe: sk_test_… while testing, sk_live_… when selling; whsec_… from the webhook endpoint
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# accounts that make pictures without paying, comma separated (the publisher's own login)
COVER_AI_FREE_EMAILS=

# --- local development (copy to .env.local) ---
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Server-side URL for PocketBase when it differs from the public one (Docker network, etc.)
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# --- seed script (npm run seed) ---
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-please
OWNER_NAME="Your Name"
