# --- production (docker compose) ---
SITE_DOMAIN=jollofpages.com
PB_DOMAIN=pb.jollofpages.com

# --- AI cover art (see docs/AI_COVERS.md); empty = test mode ---
# The web server signs in to PocketBase as a superuser to keep the credit ledger.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# fal.ai key (fal.ai/dashboard/keys). Default model: fal-ai/nano-banana-2
FAL_KEY=
# Stripe: sk_test_… while testing, sk_live_… when selling; whsec_… from the webhook endpoint
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# accounts that make pictures without paying, comma separated (the publisher's own login)
COVER_AI_FREE_EMAILS=

# --- author accounts and sites (see docs/author-sites.md) ---
# paid = sign up then pay once through Stripe; free = no payment; closed = no sign-up.
# Empty: paid when STRIPE_SECRET_KEY is set, otherwise closed.
STUDIO_SIGNUP=
# ROOT_DOMAIN=jollofpages.com

# --- Author Site Pro (see docs/author-sites.md); each part stays off until its keys are set ---
# Pro billing uses the Stripe keys above. Prices in cents.
PRO_MONTH_CENTS=1000
PRO_YEAR_CENTS=9600
# Name.com API (name.com/account/settings/api): the free first-year .com on yearly Pro
NAMECOM_USERNAME=
NAMECOM_TOKEN=
# NAMECOM_API=https://api.dev.name.com while testing
FREE_DOMAIN_TLDS=com
FREE_DOMAIN_MAX_CENTS=1500
# the address new domains point at (else the IP of ROOT_DOMAIN)
SERVER_IP=169.58.77.98
# Help requests: who sees the support inbox in the studio and gets new requests by email
# (comma separated; falls back to OWNER_EMAIL)
SUPPORT_EMAILS=
# The owner's admin (/studio/admin: writers, sales, credits): comma separated; falls back to OWNER_EMAIL
ADMIN_EMAILS=
# A long random key Jollof Studio and the AI writer send to /api/apps/access to check the
# per-writer switches on Admin > Writers > Access (openssl rand -hex 32)
APP_ACCESS_SECRET=
# Where the admin reads Jollof Studio's people and numbers (its PocketBase). The default is right for the live site.
STUDIO_PB_URL=
# Google Books (console.cloud.google.com > APIs > Books API > Credentials > API key): finds
# Kindle books Open Library doesn't know when a writer adds a book they already published
GOOGLE_BOOKS_API_KEY=
# Amazon Product Advertising API (an Amazon Associates account, affiliate-program.amazon.com >
# Tools > Product Advertising API): fills a book's author, cover and every format with its price
# from just its ASIN. The partner tag is the store ID, like "yourname-20". Optional.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

# Resend (resend.com/api-keys) for newsletters and ebook receipts; MAIL_FROM_DOMAIN must be verified there
RESEND_API_KEY=
MAIL_FROM_DOMAIN=mail.jollofpages.com
# newsletter emails each Pro author gets a month from the shared account (default 300). Authors who
# connect their own free Resend account on the Readers page send on that instead.
NEWSLETTER_MONTHLY_EMAILS=
# 1 = sell packs of extra emails on the Readers page (only worth it on a paid Resend plan)
NEWSLETTER_SELL_EMAILS=
# Jollof Pages' fee on each direct ebook sale
EBOOK_FEE_PERCENT=3
EBOOK_FEE_FIXED_CENTS=30

# --- writing assistant (docs/assistant.md) ---
# Writers bring their own Claude, ChatGPT or OpenRouter key. These are the publisher's own keys,
# used only by the accounts in COVER_AI_FREE_EMAILS. Each may be left empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# seals writers' keys in the database; any long random string (defaults to the PB superuser password)
AI_KEYS_SECRET=

# --- local development (copy to .env.local) ---
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
# Server-side URL for PocketBase when it differs from the public one (Docker network, etc.)
# POCKETBASE_INTERNAL_URL=http://127.0.0.1:8090

# --- seed script (npm run seed) ---
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me-please
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-please
OWNER_NAME="Your Name"
